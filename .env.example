# Runtime configuration
APP_ENV=development
LOG_LEVEL=INFO
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
# 必填：留空或保持占位值时，非 development 环境会拒绝启动。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 注意：换掉这个值会让所有已签发的登录令牌立即失效。
AUTH_SECRET_KEY=replace-with-a-long-random-secret
# 登录令牌有效期（分钟），默认 720 = 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 设为 1/true 时，即使在 development 也把配置问题当致命错误
STRICT_CONFIG=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 让流式回答的最后一个 chunk 带上本次 token 用量（Agent 用量统计靠它，默认开）。
# 不认这个参数的兼容网关会直接报错：后端会在"一个字都没吐出去"时不带该参数重试一次；
# 想彻底不冒这个险就设成 false，用量退回按字数估算。
LLM_INCLUDE_USAGE=true
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
EMBEDDING_MODEL=data/models/finance-embedding
RERANK_MODEL=
# 检索阈值：本地小模型的相关/不相关片段余弦距离会重叠，
# 0.45 会把"净利润怎么算"这类真正相关的片段也丢掉，默认放宽到 0.8 并配合重排使用。
RAG_MAX_DISTANCE=0.8
# 重排前的候选数（多召回 → rerank 压缩到 top_k）
RAG_CANDIDATE_K=20
# 上传落盘目录：data/raw 按仓库约定只读，导入件与文档上传件都放这两个目录下
UPLOAD_DIR=data/uploads
RAG_UPLOAD_DIR=data/uploads/documents
# 审计日志保留天数：只有 POST /admin/audit/purge 会删（并留痕），没有定时任务
AUDIT_RETENTION_DAYS=180
# 业务时区（IANA 名）：看板「今天」、报告 generated_at、审计的「从/到」日期窗口、预警外发测试通知的
# period、Agent 用量「近 N 天」的窗口都按它算。容器时区（一般是 UTC）是什么都不影响这几个口径。
# 库里一律存 UTC，只在查询/展示边界换算；审计行内时刻与导出的 CSV 仍保持 UTC（表头写着「时间(UTC)」）。
# Windows 上需要 tzdata（requirements 里已装）。非法名会出现在 /system/status 的 config_problems 里。
BUSINESS_TIMEZONE=Asia/Shanghai
# 出口配额（每分钟、按账号）：导出 30 次、问答 60 次。进程内实现（无 Redis），重启清零。
EXPORT_MAX_PER_MINUTE=30
AI_MAX_PER_MINUTE=60
# 日志格式：text（默认，给人看）或 json（一行一条，给采集侧）。uvicorn 自己的访问日志不受影响，
# 想要一份日志就加 --no-access-log（应用日志里已经带了 method/path/status/duration_ms）。
LOG_FORMAT=text
# Prometheus 抓取端点 GET /metrics：关掉（false）时该路由返回 404；
# 非空 METRICS_TOKEN 时要求 Authorization: Bearer <token>，留空表示匿名可抓。
METRICS_ENABLED=true
METRICS_TOKEN=
# 预警外发（Webhook / 邮件）：Webhook 地址与密钥配在管理页「预警外发」里，这里只放运维侧参数。
# 单次 webhook 超时（秒），最小按 0.5 秒生效
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
# 每条投递最多尝试几次（含第一次）：失败按 2^(n-1) 秒退避重试，上限 60 秒
ALERT_MAX_ATTEMPTS=3
# 邮件通道：ALERT_SMTP_HOST 留空表示「没配」，此时邮件通道的错误是配置错误（不消耗重试预算）。
# ALERT_MAIL_FROM 是发件人，收件人配在通道的 target 里（逗号分隔）。
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# 587 端口一般要 STARTTLS；465（SMTPS）这种隐式加密本平台不支持，请用 587 + STARTTLS。
ALERT_SMTP_STARTTLS=true
ALERT_MAIL_FROM=
