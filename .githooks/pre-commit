#!/bin/sh
# 提交前自检（版本化在 .githooks/ 里，用 `git config core.hooksPath .githooks` 生效，
# `scripts/init_git.py` 会把这条配置一起设好）。
#
# 默认只跑 `--quick`（编码 + 语法体检，几秒）：这两步拦的正是出过事故的那类问题——
# PowerShell 文本 cmdlet 往返把源文件写成 mojibake/BOM、语法错误进仓库。
# 想要连后端 115 个用例与前端 15 个用例一起卡住，用 `PRECOMMIT_FULL=1 git commit ...`。
set -e

if [ -x ".venv/Scripts/python.exe" ]; then
    PYTHON=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
else
    PYTHON="python"
fi

if [ "$PRECOMMIT_FULL" = "1" ]; then
    echo "[pre-commit] $PYTHON scripts/check_all.py（含后端与前端用例）"
    "$PYTHON" scripts/check_all.py
else
    echo "[pre-commit] $PYTHON scripts/check_all.py --quick"
    echo "[pre-commit] 提示：PRECOMMIT_FULL=1 git commit 会连单元测试一起跑"
    "$PYTHON" scripts/check_all.py --quick
fi
